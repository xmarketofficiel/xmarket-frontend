# Production Environment Configuration
# This file is safe to commit - contains no secrets

# =============================================================================
# API Configuration (Production URLs)
# =============================================================================

# Production Backend API URL
NEXT_PUBLIC_API_BASE_URL=https://your-backend-api.vercel.app

# Production Upload URL
NEXT_PUBLIC_UPLOAD_URL=https://your-backend-api.vercel.app/uploads

# =============================================================================
# Application Configuration
# =============================================================================

# Use real backend APIs
NEXT_PUBLIC_USE_MOCK=false

# PWA Configuration
NEXT_PUBLIC_APP_NAME=XMarket
NEXT_PUBLIC_APP_SHORT_NAME=XMarket
NEXT_PUBLIC_APP_DESCRIPTION=UM6P Campus Marketplace - Buy, Sell, Connect

# =============================================================================
# Build Configuration
# =============================================================================

# Production environment
NODE_ENV=production

# Disable telemetry
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# Performance Configuration
# =============================================================================

# Enable bundle analysis (set to true for debugging)
ANALYZE=false

# =============================================================================
# Security Configuration
# =============================================================================

# Production domain
NEXT_PUBLIC_DOMAIN=xmarket-frontend.vercel.app
