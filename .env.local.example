# XMarket Development Environment Configuration
# Copy this file to .env.local for local development

# ======================
# SERVER-SIDE ONLY (NEVER exposed to browser)
# ======================

# Backend API URL - Used ONLY by Next.js API routes (/app/api/*)
BACKEND_URL=http://localhost:3001

# ======================
# CLIENT-SIDE (Safe to expose to browser)
# ======================

# App Configuration
NEXT_PUBLIC_APP_NAME=XMarket
NEXT_PUBLIC_APP_VERSION=1.0.0

# API Configuration - Always use SSR routes to hide backend
NEXT_PUBLIC_API_BASE_URL=/api

# Feature Flags - Development settings
PWA_ENABLED=false
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
NEXT_PUBLIC_ENABLE_DEBUG_LOGGING=true
NEXT_PUBLIC_ENABLE_CONSOLE_LOGS=true

# Build Environment
NODE_ENV=development

# ======================
# SECURITY VERIFICATION
# ======================
# ✅ BACKEND_URL is server-side only - NEVER exposed to browser
# ✅ All client API calls go through /api/* routes
# ✅ Backend URL completely hidden from network tab
# ✅ No sensitive data in NEXT_PUBLIC_ variables
