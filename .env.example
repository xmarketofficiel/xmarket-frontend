# XMarket Frontend Environment Configuration

# ======================
# SERVER-SIDE ONLY (Never exposed to browser)
# ======================

# Backend API URL - Used only by Next.js API routes
BACKEND_URL=https://xmarket-backend-production-v1.up.railway.app

# Database (if needed for direct connections)
# DATABASE_URL=postgresql://...

# External API Keys (server-side only)
# CLOUDINARY_API_SECRET=your_secret_here
# STRIPE_SECRET_KEY=sk_...

# ======================
# CLIENT-SIDE (Safe to expose to browser)
# ======================

# App Configuration
NEXT_PUBLIC_APP_NAME=XMarket
NEXT_PUBLIC_APP_VERSION=1.0.0

# API Configuration - Always use /api for SSR
NEXT_PUBLIC_API_BASE_URL=/api

# Feature Flags
PWA_ENABLED=true
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=false
NEXT_PUBLIC_ENABLE_DEBUG_LOGGING=false
NEXT_PUBLIC_ENABLE_CONSOLE_LOGS=false

# Analytics (Public IDs only)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_HOTJAR_ID=1234567

# Error Reporting (Public DSN only)
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# ======================
# BUILD CONFIGURATION
# ======================

NODE_ENV=production

# ======================
# SECURITY NOTES
# ======================

# ✅ SAFE: Variables starting with NEXT_PUBLIC_ are exposed to the browser
# ❌ NEVER: Put secrets, private keys, or backend URLs in NEXT_PUBLIC_ variables
# ✅ SECURE: Server-side variables (without NEXT_PUBLIC_) are only available in API routes
# ✅ HIDDEN: Backend URL is only used in /app/api/ routes, never exposed to browser