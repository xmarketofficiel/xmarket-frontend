# XMarket Frontend Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# API Configuration
# =============================================================================

# Backend API URL - Update this for production
NEXT_PUBLIC_API_BASE_URL=https://your-backend-api.com

# Upload URL for file serving - Should match your backend
NEXT_PUBLIC_UPLOAD_URL=https://your-backend-api.com/uploads

# =============================================================================
# Application Configuration
# =============================================================================

# Use real backend APIs instead of mock data
NEXT_PUBLIC_USE_MOCK=false

# PWA Configuration
NEXT_PUBLIC_APP_NAME=XMarket
NEXT_PUBLIC_APP_SHORT_NAME=XMarket
NEXT_PUBLIC_APP_DESCRIPTION=Campus Marketplace Application

# =============================================================================
# Build Configuration
# =============================================================================

# Environment (development, staging, production)
NODE_ENV=production

# Disable Next.js telemetry for privacy
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# External Services (Optional - Add if needed)
# =============================================================================

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=GA-XXXXXXXXX

# Error Tracking (Optional)  
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# =============================================================================
# Security Configuration
# =============================================================================

# Domain for cookies (production only)
# NEXT_PUBLIC_DOMAIN=your-domain.com

# =============================================================================
# Feature Flags (Optional)
# =============================================================================

# Enable/disable features
# NEXT_PUBLIC_ENABLE_PWA=true
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true
