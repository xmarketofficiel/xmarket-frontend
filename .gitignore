*.log
*.tmp
*.temp
debug*
*debug*
create-*.js
generate-*.js

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA files
public/sw.js
public/workbox-*.js
public/worker-*.js
public/sw.js.map
public/workbox-*.js.map
public/worker-*.js.map

